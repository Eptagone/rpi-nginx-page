---
import Favicon from "@assets/raspberry.svg";
import "../fonts.scss";
import "../globals.css";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href={Favicon.src} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    </head>

    <body class="font-cascadia-code flex h-screen bg-[#002341]">
        <slot />
    </body>
</html>
